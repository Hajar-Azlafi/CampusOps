# Copier ce fichier vers .env puis remplacer uniquement les valeurs locales.
POSTGRES_DB=campusops_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe_local

JWT_SECRET=remplacer_par_une_cle_secrete_longue
ADMIN_DEFAULT_PASSWORD=remplacer_par_un_mot_de_passe_initial
RESPONSABLES_PASSWORD=remplacer_par_un_mot_de_passe_initial

# URL vue par le navigateur; elle doit rester accessible depuis l'hote.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP: laisser desactive en developpement si aucun serveur de mail n'est configure.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=remplacer_par_une_adresse_email
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=remplacer_par_une_adresse_email
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_ENABLED=false
MAIL_RESET_TOKEN_MINUTES=30

APP_LOGIN_URL=http://localhost:5173/login
APP_RESET_URL=http://localhost:5173/reset-password