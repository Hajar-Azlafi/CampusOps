# ============================================================================
#  Secrets locaux CampusOps  —  MODELE
#
#  1. Copier ce fichier en « secrets.properties » (meme dossier, a la racine du
#     module campusops-backend, a cote de pom.xml).
#  2. Y renseigner vos identifiants reels.
#  3. NE JAMAIS committer « secrets.properties » (il est deja dans .gitignore).
#
#  Ce fichier est importe automatiquement par application.properties
#  (spring.config.import=optional:file:./secrets.properties). S'il est absent,
#  l'application demarre normalement : l'envoi d'e-mails echouera simplement.
# ============================================================================

# ----- Base de donnees et securite ------------------------------------------
DB_URL=jdbc:postgresql://localhost:5434/campusops_db
DB_USERNAME=postgres
DB_PASSWORD=remplacer_par_le_mot_de_passe_local
JWT_SECRET=remplacer_par_une_cle_base64_d_au_moins_256_bits
ADMIN_DEFAULT_PASSWORD=remplacer_par_un_mot_de_passe_initial
RESPONSABLES_PASSWORD=remplacer_par_un_mot_de_passe_initial
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- SMTP Gmail -----------------------------------------------------------
# MAIL_USERNAME : votre adresse Gmail complete.
# MAIL_PASSWORD : un MOT DE PASSE D'APPLICATION Google de 16 caracteres, et NON
#                 le mot de passe de votre compte. Pour en generer un :
#                   1. Activer la validation en deux etapes sur le compte Google
#                      (https://myaccount.google.com/security)
#                   2. Aller sur https://myaccount.google.com/apppasswords
#                   3. Creer un mot de passe pour l'application « CampusOps »
#                   4. Coller les 16 caracteres ci-dessous (les espaces affiches
#                      par Google peuvent etre retires)
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Adresse expediteur affichee dans les e-mails. Avec Gmail elle doit etre egale
# a MAIL_USERNAME (sinon Google reecrit ou rejette l'envoi). Laisser commente
# pour reutiliser automatiquement MAIL_USERNAME.
#MAIL_FROM=votre.adresse@gmail.com

# ----- Variantes utiles (decommenter au besoin) -----------------------------
# Serveur de test local MailHog (aucun e-mail ne sort d'Internet) :
#MAIL_HOST=localhost
#MAIL_PORT=1025
#MAIL_SMTP_AUTH=false
#MAIL_SMTP_STARTTLS=false

# Desactiver completement l'envoi (les e-mails sont seulement journalises) :
#MAIL_ENABLED=false

# Duree de validite d'un lien de reinitialisation, en minutes (defaut : 30).
#MAIL_RESET_TOKEN_MINUTES=30

# URL du frontend utilisees dans les liens des e-mails.
#APP_LOGIN_URL=http://localhost:5173/login
#APP_RESET_URL=http://localhost:5173/reset-password
